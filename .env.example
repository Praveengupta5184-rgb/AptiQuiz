# ─── Database ─────────────────────────────────────────────────────────────────
# Docker PostgreSQL credentials (used by docker-compose.yml)
POSTGRES_USER=aptiquiz_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=aptiquiz
PGPORT=5433

# Full connection string (used by server)
DATABASE_URL=postgresql://aptiquiz_user:change_me_in_production@localhost:5433/aptiquiz

# Separate DB for automated tests (never pollutes production data)
TEST_DATABASE_URL=postgresql://aptiquiz_user:change_me_in_production@localhost:5433/aptiquiz_test

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3005

# MUST be at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_at_least_32_random_characters_generated_above

# Comma-separated list of allowed CORS origins (no trailing slash)
# For local dev: http://localhost:5173,http://localhost:3005
# For LAN test: add your LAN IP e.g. http://192.168.1.100:3005
# For production: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3005

# ─── Client (Vite) ────────────────────────────────────────────────────────────
# Leave empty in production (requests go to the same origin)
# Set to http://localhost:3005 for local dev when client runs on :5173
VITE_API_URL=

# ─── Optional ─────────────────────────────────────────────────────────────────
# NODE_ENV=production
